[app]
# (str) Title of your application
title = Scrims Game

# (str) Package name
package.name = scrimsgame

# (str) Package domain
package.domain = org.ilyanelloyd

# (str) Source code where main.py lives
source.dir = .
source.main = pipi.py

# (str) Application version
version = 1.0

# (str) Supported file extensions
source.include_exts = py,png,jpg,jpeg,ogg,wav,ttf,atlas

# (str) Python requirements
requirements = python3,pygame

# (str) Orientation
orientation = landscape

# (bool) Fullscreen
fullscreen = 1

# (str) Android permissions
android.permissions = INTERNET

[buildozer]
log_level = 2
warn_on_root = 1
